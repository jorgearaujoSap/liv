{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixtures golden de liquidación (módulo tax): casos L1 a L15 de los Docs. 02 y 03",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "configuration", "comparison", "cases"],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "version", "section"],
      "properties": {
        "code": { "enum": ["Doc. 02", "Doc. 03"] },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "section": { "type": "string", "minLength": 1 }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "const": "contracts/jsonschema/config-jurisdiccion/1.1/config_jurisdiccion_52356_2026.yaml" },
        "sha256": { "const": "e038e12a30223ce8944cb2220869b6dc52914c6a8cc90a93c273ec869680c872" }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gross_tax"],
      "properties": {
        "gross_tax": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scale", "rounding"],
          "properties": {
            "scale": { "const": 2 },
            "rounding": { "const": "HALF_UP" }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "amountInPesos": { "type": "integer" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rules", "description", "input", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^L([1-9]|1[0-5])$" },
        "row": { "type": "integer", "minimum": 1, "description": "Número de fila de la tabla del documento (si el caso sale de una fila)." },
        "rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["CA-L01", "CA-L02", "CA-L03", "CA-L04", "006-02", "006-14", "LQ-C01", "LQ-C02", "LQ-C04"] }
        },
        "description": { "type": "string", "minLength": 1 },
        "assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["MODALIDAD_B_HIPOTETICA", "ENTRADA_INFERIDA"] }
        },
        "inferred_inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "reason"],
            "properties": {
              "field": {
                "enum": [
                  "fiscal_year",
                  "vehicle_category",
                  "base_source_type",
                  "taxable_base",
                  "table_value",
                  "table_value_thousands",
                  "invoice_value_without_vat",
                  "base_adjustments",
                  "new_vehicle",
                  "accrual_date"
                ]
              },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "tarifas.MOTO",
              "causacion.proporcionalidad_nuevos",
              "redondeo.empate",
              "categorias",
              "sujecion"
            ]
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fiscal_year", "new_vehicle"],
          "if": { "properties": { "new_vehicle": { "const": true } } },
          "then": { "required": ["accrual_date"] },
          "else": { "not": { "required": ["accrual_date"] } },
          "properties": {
            "fiscal_year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
            "vehicle_category": { "enum": ["PARTICULAR", "MOTO", "ELECTRICO", "PUBLICO"] },
            "base_source_type": { "enum": ["OFFICIAL_TABLE", "INVOICE"] },
            "taxable_base": { "$ref": "#/$defs/amountInPesos" },
            "table_value": { "$ref": "#/$defs/amountInPesos" },
            "table_value_thousands": { "$ref": "#/$defs/amountInPesos" },
            "invoice_value_without_vat": { "$ref": "#/$defs/amountInPesos" },
            "base_adjustments": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["BLINDADO", "ANTIGUO_CLASICO", "INTERNACION_TEMPORAL"] }
            },
            "new_vehicle": { "type": "boolean" },
            "accrual_date": { "$ref": "#/$defs/date" }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "taxable_base": { "$ref": "#/$defs/amountInPesos" },
            "applied_rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "taxable_months": { "type": "integer", "minimum": 1, "maximum": 12 },
            "gross_tax": { "type": "number", "minimum": 0 },
            "net_tax": { "$ref": "#/$defs/amountInPesos" },
            "effective_discount": { "$ref": "#/$defs/amountInPesos", "description": "Descuento efectivo del Doc. 03 §9.3, nota 1: neto redondeado menos neto con descuento redondeado. No es el discount del Doc. 02 §B.8." },
            "net_tax_with_discount": { "$ref": "#/$defs/amountInPesos", "description": "Valor a pagar con descuento, redondeado." },
            "discount_applies": { "const": false, "description": "Solo false: el documento dice «—» (sin descuento)." },
            "discount_deadline": { "$ref": "#/$defs/date" },
            "due_date": { "$ref": "#/$defs/date" },
            "default_from": { "$ref": "#/$defs/date", "description": "Mora desde (Doc. 03 §9.7): primer día de mora." }
          }
        }
      }
    }
  }
}
