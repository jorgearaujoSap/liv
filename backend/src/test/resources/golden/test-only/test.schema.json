{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Esquema mínimo de prueba: solo lo usan las variantes dañadas de GoldenFixturesTest. No es un caso golden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "configuration", "comparison", "cases"],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "version", "section"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "section": { "type": "string", "minLength": 1 }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scale", "rounding"],
        "properties": {
          "scale": { "type": "integer", "minimum": 0 },
          "rounding": { "enum": ["HALF_UP"] }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rules", "description", "input", "expected"],
        "properties": {
          "id": { "type": "string", "pattern": "^T[0-9]+$" },
          "row": { "type": "integer", "minimum": 1 },
          "rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "description": { "type": "string", "minLength": 1 },
          "assumptions": { "type": "array", "items": { "enum": ["SYNTHETIC"] } },
          "inferred_inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "reason"],
              "properties": {
                "field": { "type": "string", "minLength": 1 },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          },
          "depends_on": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "input": { "type": "object" },
          "expected": { "type": "object", "minProperties": 1 }
        }
      }
    }
  }
}
