<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración de Spring Boot (consola y archivo) con las credenciales enmascaradas en el mensaje
  y en las trazas de excepción (doc. 02 §6, T12). Las reglas van antes del include para que los
  patrones de Spring Boot usen estos conversores en %m, %msg y %message; las trazas usan
  %maskedEx, que elige logging.exception-conversion-word en application.yml.
  El log estructurado (JSON) de Spring Boot no pasa por estos conversores: está apagado, y
  LogMaskingTest falla si alguien lo enciende sin enmascararlo antes.
-->
<configuration>
  <conversionRule conversionWord="m"
      class="co.com.sapenlinea.liv.platform.logging.MaskingMessageConverter"/>
  <conversionRule conversionWord="msg"
      class="co.com.sapenlinea.liv.platform.logging.MaskingMessageConverter"/>
  <conversionRule conversionWord="message"
      class="co.com.sapenlinea.liv.platform.logging.MaskingMessageConverter"/>
  <conversionRule conversionWord="maskedEx"
      class="co.com.sapenlinea.liv.platform.logging.MaskingThrowableConverter"/>
  <include resource="org/springframework/boot/logging/logback/base.xml"/>
</configuration>
