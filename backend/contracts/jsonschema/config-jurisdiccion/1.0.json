{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:liv:jsonschema:config-jurisdiccion:1.0",
  "title": "Configuración de jurisdicción 1.0",
  "description": "Forma del archivo YAML de configuración de jurisdicción y vigencia (Doc. 03 §5; feature 004). Valida solo la forma (CJ01): qué secciones y campos hay, de qué tipo es cada uno, cuáles son obligatorios y qué valores admiten los campos cerrados. No fija valores tributarios. Las reglas CJ02 a CJ14 son del validador de la opción 1.5.9. Esta versión es inmutable: un cambio es una versión nueva, en un archivo nuevo.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "esquema_version",
    "jurisdiccion",
    "competencia",
    "vigencia",
    "normas",
    "distribucion_recaudo"
  ],
  "properties": {
    "esquema_version": {
      "type": "string",
      "const": "1.0"
    },
    "jurisdiccion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "codigo_dane",
        "nombre",
        "departamento_padre_dane",
        "administracion",
        "estado"
      ],
      "properties": {
        "tipo": {
          "type": "string",
          "enum": [
            "DEPARTAMENTO",
            "DISTRITO_CAPITAL",
            "DISTRITO",
            "MUNICIPIO"
          ]
        },
        "codigo_dane": {
          "$ref": "#/$defs/dane"
        },
        "codigo_divipola_8": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{8}$"
            },
            {
              "$ref": "#/$defs/pendiente"
            }
          ]
        },
        "nombre": {
          "$ref": "#/$defs/texto_libre"
        },
        "departamento": {
          "$ref": "#/$defs/texto_libre"
        },
        "departamento_padre_dane": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{2}$"
            },
            {
              "$ref": "#/$defs/pendiente"
            },
            {
              "type": "null"
            }
          ]
        },
        "zona_frontera": {
          "type": "boolean"
        },
        "administracion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nombre",
            "nit"
          ],
          "properties": {
            "nombre": {
              "$ref": "#/$defs/texto_libre"
            },
            "nit": {
              "$ref": "#/$defs/texto_libre"
            }
          }
        },
        "estado": {
          "$ref": "#/$defs/estado"
        }
      }
    },
    "competencia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modalidades",
        "estado"
      ],
      "properties": {
        "modalidades": {
          "description": "Modalidades de Doc. 03 §9.5. Ninguna es obligatoria; qué combinaciones valen lo decide CJ12.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "UEDF_INTERNACION": {
              "description": "A: liquida solo los vehículos internados temporalmente.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "activa",
                "liquida",
                "universo",
                "ajuste_base",
                "requiere",
                "distribucion",
                "norma"
              ],
              "properties": {
                "activa": {
                  "type": "boolean"
                },
                "liquida": {
                  "type": "boolean"
                },
                "universo": {
                  "$ref": "#/$defs/codigo"
                },
                "ajuste_base": {
                  "$ref": "#/$defs/codigo"
                },
                "requiere": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "jurisdiccion.zona_frontera"
                  ],
                  "properties": {
                    "jurisdiccion.zona_frontera": {
                      "type": "boolean"
                    }
                  }
                },
                "distribucion": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "beneficiario",
                      "porcentaje"
                    ],
                    "properties": {
                      "beneficiario": {
                        "$ref": "#/$defs/codigo"
                      },
                      "porcentaje": {
                        "$ref": "#/$defs/fraccion"
                      }
                    }
                  }
                },
                "norma": {
                  "$ref": "#/$defs/codigo"
                }
              }
            },
            "CONVENIO_DEPTO": {
              "description": "B: liquida también los matriculados, por convenio con el departamento.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "activa",
                "liquida",
                "universo",
                "convenio",
                "distribucion",
                "norma"
              ],
              "properties": {
                "activa": {
                  "type": "boolean"
                },
                "liquida": {
                  "type": "boolean"
                },
                "universo": {
                  "$ref": "#/$defs/codigo"
                },
                "convenio": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "numero",
                    "fecha_inicio",
                    "fecha_fin",
                    "periodicidad_giro_departamento"
                  ],
                  "properties": {
                    "numero": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/texto_libre"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "fecha_inicio": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/fecha"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "fecha_fin": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/fecha"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "periodicidad_giro_departamento": {
                      "$ref": "#/$defs/codigo"
                    }
                  }
                },
                "distribucion": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "beneficiario",
                      "porcentaje",
                      "tratamiento"
                    ],
                    "properties": {
                      "beneficiario": {
                        "$ref": "#/$defs/codigo"
                      },
                      "porcentaje": {
                        "$ref": "#/$defs/fraccion"
                      },
                      "tratamiento": {
                        "$ref": "#/$defs/codigo"
                      }
                    }
                  }
                },
                "norma": {
                  "$ref": "#/$defs/codigo"
                }
              }
            },
            "PARTICIPACION_20": {
              "description": "C: no liquida; controla el 20 % que recibe.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "activa",
                "liquida",
                "universo",
                "fuente_informacion",
                "control",
                "distribucion",
                "norma"
              ],
              "properties": {
                "activa": {
                  "type": "boolean"
                },
                "liquida": {
                  "type": "boolean"
                },
                "universo": {
                  "$ref": "#/$defs/codigo"
                },
                "fuente_informacion": {
                  "$ref": "#/$defs/codigo"
                },
                "control": {
                  "$ref": "#/$defs/codigo"
                },
                "distribucion": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "beneficiario",
                      "porcentaje",
                      "tratamiento"
                    ],
                    "properties": {
                      "beneficiario": {
                        "$ref": "#/$defs/codigo"
                      },
                      "porcentaje": {
                        "$ref": "#/$defs/fraccion"
                      },
                      "tratamiento": {
                        "$ref": "#/$defs/codigo"
                      }
                    }
                  }
                },
                "norma": {
                  "$ref": "#/$defs/codigo"
                }
              }
            },
            "ADMINISTRACION_DIRECTA": {
              "description": "D: liquida los matriculados (departamentos y distritos).",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "activa"
              ],
              "properties": {
                "activa": {
                  "type": "boolean"
                },
                "liquida": {
                  "type": "boolean"
                },
                "universo": {
                  "$ref": "#/$defs/codigo"
                },
                "distribucion": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "beneficiario": {
                        "$ref": "#/$defs/codigo"
                      },
                      "porcentaje": {
                        "$ref": "#/$defs/fraccion"
                      }
                    }
                  }
                },
                "norma": {
                  "$ref": "#/$defs/codigo"
                }
              }
            }
          }
        },
        "estado": {
          "$ref": "#/$defs/estado"
        }
      }
    },
    "vigencia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anio",
        "inicio",
        "fin",
        "version_config"
      ],
      "properties": {
        "anio": {
          "$ref": "#/$defs/entero"
        },
        "inicio": {
          "$ref": "#/$defs/fecha"
        },
        "fin": {
          "$ref": "#/$defs/fecha"
        },
        "version_config": {
          "$ref": "#/$defs/entero"
        }
      }
    },
    "normas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tipo",
          "numero",
          "descripcion",
          "estado"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/codigo"
          },
          "tipo": {
            "$ref": "#/$defs/codigo"
          },
          "numero": {
            "$ref": "#/$defs/texto_libre"
          },
          "fecha": {
            "$ref": "#/$defs/fecha"
          },
          "autoridad": {
            "$ref": "#/$defs/texto_libre"
          },
          "descripcion": {
            "$ref": "#/$defs/texto_libre"
          },
          "estado": {
            "$ref": "#/$defs/estado"
          }
        }
      }
    },
    "base_gravable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogo_ministerio",
        "vehiculo_nuevo",
        "reglas_ubicacion",
        "ajustes",
        "orden_ajustes"
      ],
      "properties": {
        "catalogo_ministerio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "norma",
            "multiplicador_tablas",
            "llave_referencia",
            "columna_anio_base",
            "anio_base",
            "tablas",
            "estado"
          ],
          "properties": {
            "norma": {
              "$ref": "#/$defs/codigo"
            },
            "multiplicador_tablas": {
              "$ref": "#/$defs/entero"
            },
            "llave_referencia": {
              "$ref": "#/$defs/codigo"
            },
            "columna_anio_base": {
              "$ref": "#/$defs/texto_tecnico"
            },
            "anio_base": {
              "$ref": "#/$defs/entero"
            },
            "tablas": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "numero",
                  "nombre",
                  "atributos"
                ],
                "properties": {
                  "numero": {
                    "$ref": "#/$defs/entero"
                  },
                  "nombre": {
                    "$ref": "#/$defs/texto_tecnico"
                  },
                  "atributos": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/identificador"
                    }
                  },
                  "unidad_potencia": {
                    "$ref": "#/$defs/codigo"
                  },
                  "unidad_potencia_electricos": {
                    "$ref": "#/$defs/codigo"
                  }
                }
              }
            },
            "estado": {
              "$ref": "#/$defs/estado"
            }
          }
        },
        "vehiculo_nuevo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fuente_base",
            "incluye_iva",
            "estado"
          ],
          "properties": {
            "fuente_base": {
              "type": "string",
              "enum": [
                "FACTURA",
                "DECLARACION_IMPORTACION"
              ]
            },
            "incluye_iva": {
              "type": "boolean"
            },
            "estado": {
              "$ref": "#/$defs/estado"
            }
          }
        },
        "reglas_ubicacion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modelo_igual_o_anterior_anio_base",
            "aproximacion_cilindraje",
            "no_incluido_en_tablas",
            "autoliquidacion_superior_voluntaria",
            "vigencias_anteriores"
          ],
          "properties": {
            "modelo_igual_o_anterior_anio_base": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "usar_columna",
                "linea_no_encontrada",
                "estado"
              ],
              "properties": {
                "usar_columna": {
                  "$ref": "#/$defs/texto_tecnico"
                },
                "linea_no_encontrada": {
                  "$ref": "#/$defs/identificador"
                },
                "estado": {
                  "$ref": "#/$defs/estado"
                }
              }
            },
            "aproximacion_cilindraje": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "aplica_cuando",
                "metodo",
                "umbral_redondeo_superior",
                "estado"
              ],
              "properties": {
                "aplica_cuando": {
                  "$ref": "#/$defs/identificador"
                },
                "metodo": {
                  "$ref": "#/$defs/codigo"
                },
                "umbral_redondeo_superior": {
                  "$ref": "#/$defs/entero"
                },
                "estado": {
                  "$ref": "#/$defs/estado"
                }
              }
            },
            "no_incluido_en_tablas": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "metodo",
                "requiere_aprobacion_segundo_usuario",
                "reportar_a_sibga",
                "estado"
              ],
              "properties": {
                "metodo": {
                  "$ref": "#/$defs/codigo"
                },
                "requiere_aprobacion_segundo_usuario": {
                  "type": "boolean"
                },
                "reportar_a_sibga": {
                  "type": "boolean"
                },
                "estado": {
                  "$ref": "#/$defs/estado"
                }
              }
            },
            "autoliquidacion_superior_voluntaria": {
              "type": "boolean"
            },
            "vigencias_anteriores": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "permite_modificar_base_publicada",
                "no_incluido"
              ],
              "properties": {
                "permite_modificar_base_publicada": {
                  "type": "boolean"
                },
                "no_incluido": {
                  "$ref": "#/$defs/codigo"
                }
              }
            }
          }
        },
        "ajustes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "codigo",
              "factor",
              "norma",
              "articulo",
              "estado"
            ],
            "properties": {
              "codigo": {
                "$ref": "#/$defs/codigo"
              },
              "factor": {
                "$ref": "#/$defs/factor"
              },
              "sobre": {
                "$ref": "#/$defs/codigo"
              },
              "norma": {
                "$ref": "#/$defs/codigo"
              },
              "articulo": {
                "$ref": "#/$defs/texto_tecnico"
              },
              "aplica_solo_dane": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/dane_lista"
                }
              },
              "estado": {
                "$ref": "#/$defs/estado"
              }
            }
          }
        },
        "orden_ajustes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/codigo"
          }
        }
      }
    },
    "sujecion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_gravados",
        "motos_electricas_criterio_sujecion",
        "servicio_publico",
        "estado"
      ],
      "properties": {
        "no_gravados": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "codigo"
            ],
            "properties": {
              "codigo": {
                "$ref": "#/$defs/codigo"
              },
              "clases": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/codigo"
                }
              },
              "cilindraje_max": {
                "$ref": "#/$defs/entero"
              },
              "excepto_si": {
                "$ref": "#/$defs/ruta"
              }
            }
          }
        },
        "motos_electricas_criterio_sujecion": {
          "$ref": "#/$defs/texto_libre"
        },
        "servicio_publico": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gravado",
            "municipios_donde_esta_gravado",
            "estado"
          ],
          "properties": {
            "gravado": {
              "type": "boolean"
            },
            "municipios_donde_esta_gravado": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/dane_lista"
              }
            },
            "estado": {
              "$ref": "#/$defs/estado"
            }
          }
        },
        "estado": {
          "$ref": "#/$defs/estado"
        }
      }
    },
    "categorias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estado",
        "reglas"
      ],
      "properties": {
        "estado": {
          "$ref": "#/$defs/estado"
        },
        "reglas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "codigo",
              "si"
            ],
            "properties": {
              "codigo": {
                "$ref": "#/$defs/codigo"
              },
              "si": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tecnologia": {
                    "$ref": "#/$defs/codigo"
                  },
                  "tabla": {
                    "$ref": "#/$defs/entero"
                  },
                  "servicio": {
                    "$ref": "#/$defs/codigo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "tarifas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "categoria",
          "rangos",
          "estado"
        ],
        "properties": {
          "categoria": {
            "$ref": "#/$defs/codigo"
          },
          "norma": {
            "$ref": "#/$defs/codigo"
          },
          "tarifa_maxima": {
            "$ref": "#/$defs/fraccion"
          },
          "rangos": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "desde_exclusivo",
                "hasta_inclusivo",
                "tarifa"
              ],
              "properties": {
                "desde_exclusivo": {
                  "$ref": "#/$defs/monto"
                },
                "hasta_inclusivo": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/monto"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "tarifa": {
                  "$ref": "#/$defs/fraccion"
                }
              }
            }
          },
          "estado": {
            "$ref": "#/$defs/estado"
          }
        }
      }
    },
    "conservacion_tarifa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activa",
        "estado"
      ],
      "properties": {
        "activa": {
          "type": "boolean"
        },
        "estado": {
          "$ref": "#/$defs/estado"
        }
      }
    },
    "causacion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "general",
        "vehiculo_nuevo",
        "proporcionalidad_nuevos"
      ],
      "properties": {
        "general": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "vehiculo_nuevo": {
          "$ref": "#/$defs/codigo"
        },
        "proporcionalidad_nuevos": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activa",
            "fraccion_mes_cuenta_completo",
            "formula_meses",
            "estado"
          ],
          "properties": {
            "activa": {
              "type": "boolean"
            },
            "fraccion_mes_cuenta_completo": {
              "type": "boolean"
            },
            "formula_meses": {
              "$ref": "#/$defs/texto_tecnico"
            },
            "estado": {
              "$ref": "#/$defs/estado"
            }
          }
        }
      }
    },
    "calendario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "norma",
        "grupos",
        "inicio_mora",
        "descuento_pronto_pago",
        "vehiculos_nuevos",
        "obligatoria",
        "estado"
      ],
      "properties": {
        "norma": {
          "$ref": "#/$defs/codigo"
        },
        "grupos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "grupo",
              "fecha_inicio_pago",
              "fecha_limite_descuento",
              "fecha_limite_pago_sin_intereses"
            ],
            "properties": {
              "grupo": {
                "$ref": "#/$defs/codigo"
              },
              "fecha_inicio_pago": {
                "$ref": "#/$defs/fecha"
              },
              "fecha_limite_descuento": {
                "$ref": "#/$defs/fecha"
              },
              "fecha_limite_pago_sin_intereses": {
                "$ref": "#/$defs/fecha"
              }
            }
          }
        },
        "inicio_mora": {
          "$ref": "#/$defs/codigo"
        },
        "descuento_pronto_pago": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tarifa",
            "base",
