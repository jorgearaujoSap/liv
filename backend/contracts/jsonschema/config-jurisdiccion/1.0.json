  "$defs": {
    "estado": {
      "description": "Estado de una regla: VIGENTE (verificada contra la norma citada), POR_CONFIRMAR (valor propuesto, jurídica debe validarlo) o PENDIENTE (el equipo debe diligenciarlo).",
      "type": "string",
      "enum": [
        "VIGENTE",
        "POR_CONFIRMAR",
        "PENDIENTE"
      ]
    },
    "pendiente": {
      "description": "El texto PENDIENTE: el equipo aún debe diligenciar el campo. Que no quede ninguno al publicar lo decide CJ02.",
      "type": "string",
      "pattern": "^PENDIENTE$"
    },
    "codigo": {
      "description": "Código que lee la máquina, en mayúsculas: una opción, una referencia a una norma, una categoría. Nunca PENDIENTE ni POR_CONFIRMAR.",
      "type": "string",
      "pattern": "^(?!(PENDIENTE|POR_CONFIRMAR)$)[A-Z][A-Z0-9_]*$"
    },
    "identificador": {
      "description": "Identificador en minúsculas que lee la máquina (atributos, soportes, condiciones).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "ruta": {
      "description": "Ruta a otro campo de la configuración, con puntos (p. ej. servicio_publico.gravado).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "texto_tecnico": {
      "description": "Texto que lee la máquina (columnas de las tablas, fórmulas, números de artículo). Nunca PENDIENTE.",
      "type": "string",
      "pattern": "^(?!PENDIENTE$).+$"
    },
    "texto_libre": {
      "description": "Texto que escribe una persona (nombres, NIT, números de normas, descripciones). Admite PENDIENTE y POR_CONFIRMAR.",
      "type": "string",
      "minLength": 1
    },
    "fraccion": {
      "description": "Tasa o porcentaje como fracción entre 0 y 1 (0.015 = 1,5 %), o PENDIENTE.",
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "$ref": "#/$defs/pendiente"
        }
      ]
    },
    "factor": {
      "description": "Factor de ajuste de la base gravable, mayor que 0 (p. ej. 1.10). No es una fracción.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "monto": {
      "description": "Monto en pesos, mayor o igual que 0.",
      "type": "number",
      "minimum": 0
    },
    "entero": {
      "description": "Entero mayor o igual que 0: años, días, multiplicadores, múltiplos, umbrales, contadores. Un decimal no vale (1000.0 no es 1000).",
      "type": "integer",
      "minimum": 0
    },
    "fecha": {
      "description": "Fecha AAAA-MM-DD, o PENDIENTE. Solo se comprueba la forma; que la fecha exista lo revisa el validador de la opción 1.5.9.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        {
          "$ref": "#/$defs/pendiente"
        }
      ]
    },
    "dane": {
      "description": "Código DANE (DIVIPOLA): 2 dígitos para un departamento o 5 para un municipio, o PENDIENTE.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{2}([0-9]{3})?$"
        },
        {
          "$ref": "#/$defs/pendiente"
        }
      ]
    },
    "dane_lista": {
      "description": "Código DANE de 2 o 5 dígitos en una lista.",
      "type": "string",
      "pattern": "^[0-9]{2}([0-9]{3})?$"
    }
  }
}
