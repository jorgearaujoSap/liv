# Copia este archivo como dev/.env (no se versiona). Valores ficticios, solo para desarrollo local.
# Nunca pongas aquí credenciales de entornos reales (AGENTS.md §4.5).

POSTGRES_PORT=5433
POSTGRES_PASSWORD=postgres-dev
LIV_OWNER_PASSWORD=liv-owner-dev
LIV_APP_PASSWORD=liv-app-dev
LIV_BFF_OWNER_PASSWORD=liv-bff-owner-dev
LIV_BFF_PASSWORD=liv-bff-dev
KEYCLOAK_DB_PASSWORD=keycloak-db-dev

KEYCLOAK_PORT=8180
KEYCLOAK_MANAGEMENT_PORT=9100
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev

# Realm liv (tarea T07): URL del BFF (detrás del proxy de desarrollo del frontend) y secretos de los clientes.
# Las URL van sin barra final.
LIV_BFF_BASE_URL=http://localhost:4200
# El BFF visto desde el contenedor de Keycloak, para el cierre por canal trasero (T19): directo a su puerto, no por
# el proxy del frontend, porque /bff/backchannel-logout es para la red interna.
LIV_BFF_BACKCHANNEL_URL=http://host.docker.internal:8081
LIV_BFF_CLIENT_SECRET=liv-bff-dev
LIV_BFF_SERVICE_CLIENT_SECRET=liv-bff-service-dev
LIV_AUDIT_IMPORTER_SECRET=liv-audit-importer-dev
