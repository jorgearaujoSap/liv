<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>co.com.sapenlinea.liv</groupId>
  <artifactId>liv-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>liv-api</name>
  <description>API REST — Liquidación y recaudo del impuesto vehicular (monolito modular)</description>

  <properties>
    <java.version>21</java.version>
    <spring-modulith.version>2.1.1</spring-modulith.version>
    <archunit.version>1.5.1</archunit.version>
    <spotless.version>3.10.4</spotless.version>
    <google-java-format.version>2.0.0</google-java-format.version>
    <openapi-generator.version>7.26.0</openapi-generator.version>
    <openapi-diff.version>2.1.7</openapi-diff.version>
    <shedlock.version>7.10.1</shedlock.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Servidor de recursos OAuth2 (ADR 0023): valida los tokens con OIDC estándar (001-20). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <!-- Persistencia (ADR 0023): el gestor de transacciones de platform fija el contexto RLS. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-actuator</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Outbox de eventos en JDBC (ADR 0023): los eventos de core llegan a la auditoría aunque la
         instancia se caiga después del commit (tabla platform.event_publication). -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-jdbc</artifactId>
    </dependency>
    <!-- Importador de eventos del proveedor (ADR 0023): client credentials de liv-audit-importer y un
         solo importador a la vez entre réplicas (tabla platform.shedlock). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-spring</artifactId>
      <version>${shedlock.version}</version>
    </dependency>
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-provider-jdbc-template</artifactId>
      <version>${shedlock.version}</version>
    </dependency>

    <!-- Migraciones (ADR 0023): Flyway solo corre en los perfiles dev y test; la aplicación usa liv_app. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Comparador de cambios incompatibles de los contratos (Q08, doc. 01 §10, ADR 0027). No corre
             en el build: lo invoca contracts/scripts/compare.sh, una vez por contrato. -->
        <plugin>
          <groupId>org.openapitools.openapidiff</groupId>
          <artifactId>openapi-diff-maven</artifactId>
          <version>${openapi-diff.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- API contract-first (ADR 0005, doc. 01 §10): interfaces de servidor generadas desde
           contracts/openapi, una ejecución por contrato. La generación valida el OpenAPI y falla el
           build si no es válido. El código generado queda en target/ y no se edita. -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <configuration>
          <generatorName>spring</generatorName>
          <validateSpec>true</validateSpec>
          <generateApiTests>false</generateApiTests>
          <generateModelTests>false</generateModelTests>
          <generateApiDocumentation>false</generateApiDocumentation>
          <generateModelDocumentation>false</generateModelDocumentation>
          <generateSupportingFiles>false</generateSupportingFiles>
          <!-- Problem se responde con el ProblemDetail de Spring (RFC 9457); no se genera. -->
          <schemaMappings>
            <schemaMapping>Problem=org.springframework.http.ProblemDetail</schemaMapping>
          </schemaMappings>
          <cleanupOutput>true</cleanupOutput>
          <configOptions>
            <interfaceOnly>true</interfaceOnly>
            <skipDefaultInterface>true</skipDefaultInterface>
            <!-- Spring Boot 4: Jackson 3 y JSpecify. Sin @Validated en la interfaz, para que la
                 validación la haga Spring MVC y responda 400 con Problem Details, no 500. -->
            <useSpringBoot4>true</useSpringBoot4>
            <useJackson3>true</useJackson3>
            <useJspecify>true</useJspecify>
            <useSpringBuiltInValidation>true</useSpringBuiltInValidation>
            <useTags>true</useTags>
            <useBeanValidation>true</useBeanValidation>
            <openApiNullable>false</openApiNullable>
            <documentationProvider>none</documentationProvider>
            <annotationLibrary>none</annotationLibrary>
            <hideGenerationTimestamp>true</hideGenerationTimestamp>
            <sourceFolder>src/main/java</sourceFolder>
          </configOptions>
        </configuration>
        <executions>
          <execution>
            <id>contract-core</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/contracts/openapi/core.yaml</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi/core</output>
              <apiPackage>co.com.sapenlinea.liv.core.api.contract</apiPackage>
              <modelPackage>co.com.sapenlinea.liv.core.api.contract.model</modelPackage>
            </configuration>
          </execution>
          <execution>
            <id>contract-core-internal</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/contracts/openapi/core-internal.yaml</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi/core-internal</output>
              <apiPackage>co.com.sapenlinea.liv.core.api.contract.internal</apiPackage>
              <modelPackage>co.com.sapenlinea.liv.core.api.contract.internal.model</modelPackage>
            </configuration>
          </execution>
          <execution>
            <id>contract-platform</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/contracts/openapi/platform.yaml</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi/platform</output>
              <apiPackage>co.com.sapenlinea.liv.platform.api.contract</apiPackage>
              <modelPackage>co.com.sapenlinea.liv.platform.api.contract.model</modelPackage>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Formato con Google Java Format (2 espacios, convención del equipo). spotless:check corre en verify. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
